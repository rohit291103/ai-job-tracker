# Supabase Postgres connection string.
# Dashboard -> Project Settings -> Database -> Connection string -> URI.
# Use the pooled (port 6543) string for the app and the direct (5432) one for
# drizzle-kit, which needs session-level features the pooler doesn't expose.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-ap-south-1.pooler.supabase.com:6543/postgres

# Classification. Haiku 4.5 per ARCHITECTURE.md section 7 - template matching
# handles the bulk deterministically and this is only the fallback path.
ANTHROPIC_API_KEY=sk-ant-...

# Shared secret the Apps Script ingester sends as a bearer token. Generate with:
#   openssl rand -hex 32
INGEST_SECRET=

# The single user's id, from `select id from users where email = '...'`.
# Phase 1 is one user (ARCHITECTURE.md section 8); this goes away with real auth.
DEFAULT_USER_ID=
